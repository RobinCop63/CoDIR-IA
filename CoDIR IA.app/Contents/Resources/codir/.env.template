# ============================================
#  CoDIR IA v16.3.3.22 — .env TEMPLATE
# ============================================
#
# RECOMMANDATION : Utilisez plutôt l'interface Configuration
# dans l'application pour gérer vos clés API.
#
# Les clés seront stockées dans secrets.json :
# - Windows: %APPDATA%\CoDIR-IA\secrets.json
# - macOS/Linux: ~/.config/codir-ia/secrets.json
#
# Ce fichier .env sert de FALLBACK si secrets.json n'existe pas.
#
# ⚠️ Ne partagez JAMAIS ce fichier avec vos clés !
# ============================================

# --- OpenAI ---
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o

# --- Google / Gemini ---
# Le SDK google-genai lit GOOGLE_API_KEY ou GEMINI_API_KEY
GOOGLE_API_KEY=
GEMINI_API_KEY=
GOOGLE_MODEL=gemini-2.0-flash

# --- Anthropic / Claude ---
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-5

# --- Mistral ---
MISTRAL_API_KEY=
MISTRAL_MODEL=mistral-large-latest
