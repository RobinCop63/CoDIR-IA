#!/bin/bash
# CoDIR IA macOS launcher (.app) — no Terminal required
set -e
APP_DIR="$(cd "$(dirname "$0")/.." && pwd)"
RES_DIR="$APP_DIR/Resources/codir"
APP_SUPPORT="$HOME/Library/Application Support/CoDIR IA"
WORK_DIR="$APP_SUPPORT/runtime"
OUT_DIR="$APP_SUPPORT/outputs"
LOG_DIR="$APP_SUPPORT/logs"
mkdir -p "$WORK_DIR" "$OUT_DIR" "$LOG_DIR"
SETUP_LOG="$LOG_DIR/setup_macos.log"
RUN_LOG="$LOG_DIR/streamlit_macos.log"

# ── Détection de version : recopie si le .app est plus récent que le runtime ──
APP_VERSION_FILE="$RES_DIR/.codir_version"
WORK_VERSION_FILE="$WORK_DIR/.codir_version"

need_copy=0
if [ ! -f "$WORK_DIR/app.py" ]; then
  need_copy=1
elif [ -f "$APP_VERSION_FILE" ] && [ -f "$WORK_VERSION_FILE" ]; then
  APP_VER=$(cat "$APP_VERSION_FILE" 2>/dev/null || echo "0")
  WORK_VER=$(cat "$WORK_VERSION_FILE" 2>/dev/null || echo "0")
  if [ "$APP_VER" != "$WORK_VER" ]; then
    need_copy=1
  fi
elif [ -f "$APP_VERSION_FILE" ] && [ ! -f "$WORK_VERSION_FILE" ]; then
  need_copy=1
fi

if [ "$need_copy" -eq 1 ]; then
  # Conserver les données utilisateur (clés API, outputs, settings)
  mkdir -p "$WORK_DIR"
  [ -f "$WORK_DIR/secrets.json" ] && /bin/cp "$WORK_DIR/secrets.json" /tmp/_codir_secrets_bak.json 2>/dev/null || true
  [ -f "$WORK_DIR/config/settings.json" ] && /bin/cp "$WORK_DIR/config/settings.json" /tmp/_codir_settings_bak.json 2>/dev/null || true
  # Copier les nouveaux fichiers
  /bin/cp -R "$RES_DIR"/* "$WORK_DIR"/ >/dev/null 2>&1 || true
  # Restaurer les données utilisateur
  [ -f /tmp/_codir_secrets_bak.json ]  && /bin/cp /tmp/_codir_secrets_bak.json "$WORK_DIR/secrets.json" 2>/dev/null || true
  [ -f /tmp/_codir_settings_bak.json ] && /bin/mkdir -p "$WORK_DIR/config" && /bin/cp /tmp/_codir_settings_bak.json "$WORK_DIR/config/settings.json" 2>/dev/null || true
fi

cd "$WORK_DIR"

# Ensure venv exists + deps installed
export CODIR_NO_AUTOSTART=1
export CODIR_LOG_DIR="$LOG_DIR"
NEED_SETUP=0
if [ ! -d ".venv" ]; then
  NEED_SETUP=1
else
  # If Streamlit not installed (or broken venv), rerun setup
  ".venv/bin/python" -c "import streamlit" >/dev/null 2>&1 || NEED_SETUP=1
fi

if [ "$NEED_SETUP" -eq 1 ]; then
  /bin/bash "./setup_macos.sh" >"$SETUP_LOG" 2>&1 || {
    osascript -e 'display dialog "CoDIR IA : échec du setup. Consultez le log dans ~/Library/Application Support/CoDIR IA/logs/setup_macos.log" buttons {"OK"} default button 1' >/dev/null 2>&1 || true
    exit 1
  }
fi

# Start Streamlit in background (log to user logs)
PORT=$(".venv/bin/python" - <<'PYPORT'
import socket
s=socket.socket()
s.bind(('127.0.0.1',0))
print(s.getsockname()[1])
s.close()
PYPORT
)
[ -z "$PORT" ] && PORT=8501

nohup ".venv/bin/python" -m streamlit run app.py \
  --server.address 127.0.0.1 \
  --server.port $PORT \
  --server.headless true \
  --browser.gatherUsageStats=false \
  >"$RUN_LOG" 2>&1 &

# Wait for Streamlit to be ready, then open UI
READY=0
for i in $(seq 1 60); do
  if /usr/bin/curl -fs "http://127.0.0.1:$PORT" >/dev/null 2>&1; then
    READY=1
    break
  fi
  sleep 0.5
done

if [ "$READY" -eq 1 ]; then
  open "http://127.0.0.1:$PORT" >/dev/null 2>&1 || true
else
  osascript -e 'display dialog "CoDIR IA : Streamlit ne répond pas. Consultez le log dans ~/Library/Application Support/CoDIR IA/logs/streamlit_macos.log" buttons {"OK"} default button 1' >/dev/null 2>&1 || true
fi
exit 0
